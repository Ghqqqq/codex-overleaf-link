{
  "manifest_version": 3,
  "name": "Codex Overleaf Link",
  "version": "2.2.1",
  "description": "Connect the active Overleaf project to a local Codex bridge.",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "key": "",
  "permissions": [
    "alarms",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "https://www.overleaf.com/project",
    "https://overleaf.com/project",
    "https://www.overleaf.com/project/*",
    "https://overleaf.com/project/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.overleaf.com/project",
        "https://overleaf.com/project",
        "https://www.overleaf.com/project/*",
        "https://overleaf.com/project/*"
      ],
      "js": [
        "src/shared/summary.js",
        "src/shared/failureReasons.js",
        "src/shared/agentTranscript.js",
        "src/shared/reviewing.js",
        "src/shared/projectFiles.js",
        "src/shared/lineReferences.js",
        "src/shared/undoOperations.js",
        "src/shared/otText.js",
        "src/shared/i18n.js",
        "src/shared/models.js",
        "src/shared/providerProfiles.js",
        "src/shared/runInputQueue.js",
        "src/shared/sessionState.js",
        "src/shared/storageKeys.js",
        "src/shared/staleGuard.js",
        "src/shared/storageRunActions.js",
        "src/shared/storageDb.js",
        "src/shared/storageMigration.js",
        "src/shared/compileAdapter.js",
        "src/shared/compatibility.js",
        "src/shared/governanceRules.js",
        "src/shared/sensitiveScan.js",
        "src/shared/auditRecords.js",
        "src/content/nativeChannel.js",
        "src/content/writebackController.js",
        "src/content/reviewHunks.js",
        "src/content/diffReviewPanel.js",
        "src/content/contextTray.js",
        "src/content/localSkillsPanel.js",
        "src/content/runController.js",
        "src/content/mirrorHealth.js",
        "src/content/otWarmMirrorController.js",
        "src/content/composerAttachments.js",
        "src/content/panelRenderer.js",
        "src/content/sessionPanel.js",
        "src/content/settingsPanel.js",
        "src/content/providerSettingsDialog.js",
        "src/content/projectProviderSelection.js",
        "src/content/providerSettingsCoordinator.js",
        "src/content/sessionPersistence.js",
        "src/content/diagnosticsPanel.js",
        "src/content/runQueueScheduler.js",
        "src/content/activeTurnControl.js",
        "src/content/pendingInputView.js",
        "src/content/composerPanel.js",
        "src/content/themeController.js",
        "vendor/katex/katex.min.js",
        "vendor/markdown-it/markdown-it.min.js",
        "src/content/mathText.js",
        "src/content/markdownDomRenderer.js",
        "src/content/markdownText.js",
        "src/content/diagnosticsController.js",
        "src/content/runGuidanceView.js",
        "src/content/runGuidanceController.js",
        "src/content/runTimelineView.js",
        "src/content/projectSettingsCoordinator.js",
        "src/content/sessionMenuView.js",
        "src/content/sessionManager.js",
        "src/content/applyResultFormatters.js",
        "src/content/modelPickerSupport.js",
        "src/content/modelPicker.js",
        "src/content/projectSessionCleanup.js",
        "src/content/recentProjects.js",
        "src/content/otWarmMirror.js",
        "src/content/writebackOrchestrator.js",
        "src/content/panelMaintenance.js",
        "src/content/updateIdle.js",
        "src/content/updateNotice.js",
        "src/content/contentRuntime.js",
        "src/contentScript.js"
      ],
      "css": [
        "vendor/katex/katex.min.css",
        "styles/panel.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/icons/codex-overleaf-icon.png",
        "assets/icons/codex-overleaf-dialog-icon.png",
        "vendor/katex/fonts/*",
        "src/shared/reviewing.js",
        "src/shared/projectFiles.js",
        "src/shared/compatibility.js",
        "src/shared/staleGuard.js",
        "src/shared/compileAdapter.js",
        "src/shared/otText.js",
        "src/shared/governanceRules.js",
        "src/shared/sensitiveScan.js",
        "src/shared/auditRecords.js",
        "src/page/overleafCapabilities.js",
        "src/page/saveState.js",
        "src/page/compileBridge.js",
        "src/page/overleafEditor.js",
        "src/page/overleafProjectSnapshot.js",
        "src/page/overleafRealtimeObserver.js",
        "src/page/pageBridgeCapability.js",
        "src/page/treeOperations.js",
        "src/page/snapshotRouter.js",
        "src/page/writeGuard.js",
        "src/page/trackedChangesLifecycle.js",
        "src/page/writebackRouter.js",
        "src/pageBridge.js"
      ],
      "matches": [
        "https://www.overleaf.com/*",
        "https://overleaf.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "Codex Overleaf Link",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    },
    "default_popup": "popup.html"
  }
}
